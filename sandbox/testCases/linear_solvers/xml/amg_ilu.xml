<ParameterList name="MueLu">
  <!-- SA-AMG
       smoother  ILU(0)
       coarse    KLU -->
  <Parameter name="verbosity" type="string" value="none"/>
  <Parameter name="multigrid algorithm" type="string" value="sa"/>
  <Parameter name="max levels" type="int" value="3"/>
  <Parameter name="coarse: max size" type="int" value="500"/>
  <Parameter name="coarse: type" type="string" value="KLU"/>
  <Parameter name="aggregation: type" type="string" value="uncoupled"/>
  <Parameter name="sa: damping factor" type="double" value="1.333333"/>
  <Parameter name="sa: eigen-analysis type" type="string" value="power-method"/>
  <Parameter name="smoother: type" type="string" value="RILUK"/>
  <ParameterList name="smoother: params">
    <Parameter name="fact: iluk level-of-fill" type="int" value="0"/>
  </ParameterList>
</ParameterList>
