%YAML 1.1
---
# Solve deck: minimize 0.5 * integral(T^2) + 0.5 * gamma * integral(ctrl^2)
# subject to -Delta T = 12*pi^2*sin(2*pi*x)*sin(2*pi*y)*sin(2*pi*z) + ctrl,
# T = 0 on all faces. State-homogeneous quadratic objective + control-quadratic
# regularization stays inside MrHyDE_Objective's exact HessVec supported class.
#
# OTHER_DECKS_DIR selects exact (with src_gate) or fd (without) HessVec path.
# GAMMA is the L2 control regularization weight.
ANONYMOUS:
  debug level: 0
  verbosity: 0
  Mesh:
    dimension: 3
    element type: hex
    xmin: 0.0
    xmax: 1.0
    ymin: 0.0
    ymax: 1.0
    zmin: 0.0
    zmax: 1.0
    NX: NELEM
    NY: NELEM
    NZ: NELEM
    Xprocs: 2
    Yprocs: 2
    Zprocs: 1
  Physics:
    modules: thermal
    active controls: true
    Initial conditions:
      T: '0.0'
    Dirichlet conditions:
      T:
        all boundaries: '0.0'
  Discretization:
    order:
      T: 1
    quadrature: 2
  Parameters input file: OTHER_DECKS_DIR/input_params.yaml
  Functions input file: OTHER_DECKS_DIR/input_functions.yaml
  Analysis input file: ../../rol_decks/rol_solve.yaml
  Solver:
    solver: steady-state
    workset size: 100
    linear TOL: 1.0e-14
    max linear iters: 200
    nonlinear TOL: 1.0e-12
    max nonlinear iters: 3
    use preconditioner: true
  Postprocess:
    write solution: false
    compute objective: true
    compute errors: true
    # T*(x,y,z) = c(gamma) * sin(2 pi x) sin(2 pi y) sin(2 pi z), where
    # c(gamma) = gamma*(12 pi^2)^2 / (1 + gamma*(12 pi^2)^2). Single-mode
    # analytic solution; MrHyDE prints 'L2 norm of the error for T' at end.
    True solutions:
      T: 'GAMMA*(12.0*pi*pi)*(12.0*pi*pi)/(1.0 + GAMMA*(12.0*pi*pi)*(12.0*pi*pi))*sin(2*pi*x)*sin(2*pi*y)*sin(2*pi*z)'
    Extra fields:
      ctrl: 'ctrl_source'
      T_unctrl: 'sin(2*pi*x)*sin(2*pi*y)*sin(2*pi*z)'
      ctrl_analytical: '-12.0*pi*pi*sin(2*pi*x)*sin(2*pi*y)*sin(2*pi*z)/(1.0 + GAMMA*(12.0*pi*pi)*(12.0*pi*pi))'
    Objective functions:
      Thermal Energy:
        type: integrated control
        function: '0.5*T*T'
        weight: 1.0
      RegObj:
        type: integrated control
        function: '0.0'
        weight: 0.0
        Regularization functions:
          l2reg:
            type: integrated
            location: volume
            function: '0.5*ctrl_source*ctrl_source'
            weight: GAMMA
...
